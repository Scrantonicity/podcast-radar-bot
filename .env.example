# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Which podcast to run ---
# Selects shows/<SHOW>/ (config.py + strings.py + prompt.txt). "demo" is the
# bundled fictional Hebrew example; copy shows/_template/ for your own show. See README.
SHOW=demo

# --- Speech-to-text ---
SPEECHMATICS_API_KEY=          # Speechmatics STT (main transcription pipeline)
SONIOX_API_KEY=                # Soniox STT — optional, comparison only

# --- Extraction (Google Gemini) ---
GOOGLE_API_KEY=                # Google AI Studio key (AIza...) for Gemini extraction
EXTRACTION_MODEL=gemini-2.5-flash   # SINGLE SOURCE OF TRUTH for the model id

# --- Entity resolution + dedup (resolve_entities.py / scripts/backfill_cleanup.py) ---
RESOLVE_MODEL=gemini-2.5-flash       # model for the resolution + backfill passes
EMBEDDING_MODEL=gemini-embedding-001 # embeddings for cross-lingual duplicate matching

# --- Notion ---
NOTION_TOKEN=                  # Notion integration token (ntn_...)
NOTION_EPISODES_DB_ID=         # Episodes database id
NOTION_ENTITIES_DB_ID=         # Entities database id
NOTION_EPISODES_DS_ID=         # Episodes data-source id (Notion data-source API)
NOTION_ENTITIES_DS_ID=         # Entities data-source id (Notion data-source API)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # Bot token from @BotFather (123456:AA...)
# Broadcast target. The bot must be an ADMIN of the channel with "Post Messages".
# Public channel:  @channelusername      Private channel: -100xxxxxxxxxx (numeric id)
TELEGRAM_CHAT_ID=@your_channel
ENABLE_TELEGRAM=true           # false disables channel posting

# Approval flow (recommended): nothing reaches the channel until you tap Approve.
ENABLE_ALERTS=false            # send per-failure + summary alerts to the private chat
TELEGRAM_ALERT_CHAT_ID=        # private chat for drafts + alerts (your numeric user id; /start the bot)
TELEGRAM_APPROVER_ID=          # numeric user id allowed to approve channel posts (unset => never auto-posts)

# --- Email (disabled scaffold) ---
ENABLE_EMAIL=false
RESEND_API_KEY=                # Resend API key (only if ENABLE_EMAIL=true)
EMAIL_FROM=                    # Sender address
EMAIL_TO=                      # Recipient address
